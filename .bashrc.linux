# .bashrc.linux -- Linux-specific config

# Fedora: keep muscle-memory `yum` pointed at dnf.
alias yum='/usr/bin/dnf'

# System Java environment.
source_file "/etc/java/java.conf"
if [ ! -z "${JAVA_HOME}" ]; then
    export JAVA_HOME
fi

# rpm spec helper (spectool ships with rpmdevtools).
function rpmspec_download_upstream() {
    spectool -g -S $1
}
